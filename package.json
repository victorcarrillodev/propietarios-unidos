{
  "name": "propietarios-unidos",
  "description": "Sitio web y panel de administración de Propietarios Unidos en Mejoras del Bosque La Primavera",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "db:up": "bun scripts/db.ts up",
    "db:down": "bun scripts/db.ts down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:demo": "bun scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "icons": "bun scripts/generate-icons.ts",
    "setup": "bun run db:up && bun run db:migrate && bun run db:seed"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@remix-run/form-data-parser": "^0.17.5",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.1"
  }
}
