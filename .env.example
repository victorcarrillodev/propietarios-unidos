# Base de datos PostgreSQL (docker compose levanta una en el puerto 5432)
DATABASE_URL=postgres://propietarios:propietarios@localhost:5432/propietarios_unidos

# Secreto para firmar las cookies de sesión (mínimo 32 caracteres).
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL pública del sitio (enlaces para redes sociales, sitemap y cookies seguras)
SITE_URL=http://localhost:5173

# Carpeta donde se guardan los archivos subidos (documentos, imágenes, fotos)
STORAGE_DIR=./storage

# Primer usuario administrador (lo crea `bun run db:seed`).
# Si dejas la contraseña vacía se generará una aleatoria y se mostrará en consola.
ADMIN_NAME=Administración
ADMIN_EMAIL=admin@propietariosunidos.mx
ADMIN_PASSWORD=

# Pon "true" si la app corre detrás de un proxy (Nginx, Caddy, Traefik, etc.)
TRUST_PROXY=false

# Correo saliente (avisos de contacto/reporte/solicitud de ingreso al correo
# configurado en Panel → Configuración). Crea una cuenta gratis en resend.com,
# verifica tu dominio ahí (te dan registros DNS para agregar en Cloudflare) y
# copia la API key. Si se deja vacío, la app sigue funcionando pero solo
# registra en consola que el correo no se envió.
RESEND_API_KEY=
MAIL_FROM=Propietarios Unidos <notificaciones@propietariosunidosblp.com.mx>

# Google Analytics (GA4). Se obtiene en analytics.google.com → Admin →
# Flujos de datos → tu flujo web → "ID de MEDICIÓN" (formato G-XXXXXXXXXX).
# Si se deja vacío, no se carga el script. Nunca se carga en /admin.
GA_MEASUREMENT_ID=

# Contentsquare (antes Hotjar: hoy las cuentas nuevas se crean en
# contentsquare.com). En el dashboard → "Install tag" → modo manual, el Tag ID
# son los 13 caracteres al final de la URL del script (t.contentsquare.net/uxa/<esto>.js).
# Si se deja vacío, no se carga el script. Nunca se carga en /admin.
CONTENTSQUARE_TAG_ID=
